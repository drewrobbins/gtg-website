<!-- Floating Cart -->
<div class="floating-cart" id="floatingCart">
  <button class="floating-cart-btn" onclick="window.location.href='order.html'">
    🛒 <span id="fc-items">0 items</span> · <span id="fc-total" style="color:var(--gold);">$0</span>
  </button>
</div>

<script src="cart.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', updateFloatingCart);
  document.addEventListener('cartUpdated', updateFloatingCart);
  function updateFloatingCart() {
    const count = getItemCount();
    const sub = getSubtotal();
    const fc = document.getElementById('floatingCart');
    document.getElementById('fc-items').textContent = count + (count === 1 ? ' item' : ' items');
    document.getElementById('fc-total').textContent = '$' + sub.toFixed(2);
    fc.classList.toggle('visible', count > 0);
  }
</script>
