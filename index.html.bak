<script>
// ================================================================
// THIS WEEK'S MENU — UPDATE THIS EVERY WEEK
// Swap items below to reflect what Chef Gary is making this week.
// Badge classes: badge-bestseller | badge-chefs-pick | badge-3p | badge-new | badge-wan | badge-limited
// ================================================================
const WEEKLY_ITEMS = [
  {
    id: 'beef-strada',
    name: 'Beef Strada',
    desc: 'Premium ground beef, eggs, aged cheddar. Zero carb. Our carnivore flagship.',
    price: 48,
    tierLabel: '🥩 Pure Carnivore', tierClass: 'tier-carnivore',
    badges: [{ text: '🏆 Bestseller', cls: 'badge-bestseller' }, { text: '✅ 3P Approved', cls: 'badge-3p' }],
    img: 'images/Beef-Strada.jpg'
  },
  {
    id: 'lamb-strada',
    name: 'Lamb Strada',
    desc: 'Pasture-raised lamb, rosemary, eggs, manchego. Rich, deeply satisfying.',
    price: 52,
    tierLabel: '🥩 Pure Carnivore', tierClass: 'tier-carnivore',
    badges: [{ text: '⭐ Chef's Pick', cls: 'badge-chefs-pick' }, { text: '✅ 3P Approved', cls: 'badge-3p' }],
    img: 'images/Lamb-Strada.jpg'
  },
  {
    id: 'shrimp-etouffee',
    name: 'Shrimp Étouffée',
    desc: 'Gulf shrimp in rich Cajun roux, served over cauliflower rice upon request.',
    price: 34,
    tierLabel: '🌿 Low Carb', tierClass: 'tier-lowcarb',
    badges: [{ text: '🏆 Bestseller', cls: 'badge-bestseller' }],
    img: 'images/Shrimp-Etouffee-copy-300x200.png'
  },
  {
    id: 'chicken-gumbo',
    name: 'Chicken & Sausage Gumbo',
    desc: 'Deep dark roux, andouille sausage, Gulf seasoning. A Florida Panhandle classic.',
    price: 18,
    tierLabel: '🌿 Low Carb', tierClass: 'tier-lowcarb',
    badges: [{ text: '⭐ Chef's Pick', cls: 'badge-chefs-pick' }, { text: '🏆 Bestseller', cls: 'badge-bestseller' }],
    img: 'images/Chicken-and-Andouille-Sausage-Gumbo-rich-dark-roux-with-Creole-seasoning-add-rice-1-300x300.jpeg'
  },
  {
    id: 'meatloaf',
    name: 'Market Street Meatloaf',
    desc: 'Classic all-beef meatloaf, minimal binders, rosemary whipped potatoes.',
    price: 30,
    tierLabel: '🥩 Carnivore Light', tierClass: 'tier-carnivore-light',
    badges: [],
    img: 'images/Market-Street-Meatloaf-w-Rosemary-Whipped-Potatoes-2-300x300.jpeg'
  },
  {
    id: 'bread-pudding',
    name: 'New Orleans Bread Pudding',
    desc: "Brioche, bourbon vanilla sauce, toasted pecans. Chef Gary's most-requested dessert.",
    price: 13,
    tierLabel: '🍽️ GTG Classic', tierClass: 'tier-classic',
    badges: [{ text: '🏆 Bestseller', cls: 'badge-bestseller' }, { text: '⭐ Chef's Pick', cls: 'badge-chefs-pick' }],
    img: 'images/Bread-pudding-300x300.jpg'
  }
];

// — Carousel engine (no edits needed below) —
let carouselPos = 0;

function getVisible() {
  return window.innerWidth > 900 ? 3 : window.innerWidth > 600 ? 2 : 1;
}

function carouselInit() {
  const track = document.getElementById('carouselTrack');
  const dots  = document.getElementById('carouselDots');
  if (!track) return;
  track.innerHTML = WEEKLY_ITEMS.map((item) => {
    const badgeHTML = [
      `<span class="tier-badge ${item.tierClass}">${item.tierLabel}</span>`,
      ...item.badges.map(b => `<span class="badge ${b.cls}">${b.text}</span>`)
    ].join(' ');
    const imgHTML = item.img
      ? `<img class="carousel-slide-img" src="${item.img}" alt="${item.name}" onerror="this.style.display='none'" loading="lazy" />`
      : `<div class="carousel-slide-img-placeholder">🍽️</div>`;
    return `<div class="carousel-slide" data-item-id="${item.id}">
      ${imgHTML}
      <div class="carousel-slide-body">
        <div class="menu-badges">${badgeHTML}</div>
        <h4>${item.name}</h4>
        <p>${item.desc}</p>
        <div class="carousel-slide-footer">
          <span class="carousel-slide-price">$${item.price}</span>
          <button class="add-to-cart-btn" onclick="addToCart('${item.id}','${item.name}',${item.price},'${item.tierLabel}','${item.img}')">+ Add to Cart</button>
        </div>
      </div>
    </div>`;
  }).join('');
  dots.innerHTML = WEEKLY_ITEMS.map((_, i) =>
    `<button class="carousel-dot${i===0?' active':''}" onclick="carouselTo(${i})" aria-label="Slide ${i+1}"></button>`
  ).join('');
  carouselUpdate();
}

function carouselUpdate() {
  const track   = document.getElementById('carouselTrack');
  const dotsEl  = document.querySelectorAll('.carousel-dot');
  const prevBtn = document.getElementById('carouselPrev');
  const nextBtn = document.getElementById('carouselNext');
  if (!track || !track.children.length) return;
  const vis    = getVisible();
  const max    = Math.max(0, WEEKLY_ITEMS.length - vis);
  carouselPos  = Math.min(Math.max(carouselPos, 0), max);
  const gap    = 20;
  const slideW = track.children[0].offsetWidth + gap;
  track.style.transform = `translateX(-${carouselPos * slideW}px)`;
  dotsEl.forEach((d, i) => d.classList.toggle('active', i === carouselPos));
  if (prevBtn) prevBtn.disabled = carouselPos === 0;
  if (nextBtn) nextBtn.disabled = carouselPos >= max;
}

function carouselMove(dir) { carouselPos += dir; carouselUpdate(); }
function carouselTo(i)     { carouselPos = i;   carouselUpdate(); }

document.addEventListener('DOMContentLoaded', carouselInit);
window.addEventListener('resize', () => { carouselPos = 0; carouselUpdate(); });

// Touch/swipe
(function() {
  let startX = 0;
  document.addEventListener('DOMContentLoaded', () => {
    const vp = document.querySelector('.carousel-viewport');
    if (!vp) return;
    vp.addEventListener('touchstart', e => { startX = e.touches[0].clientX; }, { passive: true });
    vp.addEventListener('touchend',   e => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 40) carouselMove(dx < 0 ? 1 : -1);
    }, { passive: true });
  });
})();
</script>

